{
  "name": "atrium",
  "type": "module",
  "private": true,
  "engines": {
    "bun": ">=1.3.11"
  },
  "scripts": {
    "build:web": "vite build",
    "gen:assets": "bun run scripts/gen-assets.ts",
    "build:server": "bun run gen:assets && bun build --compile --outfile=atrium src/index.ts",
    "build": "bun run build:web && bun run build:server",
    "test": "bun test",
    "typecheck": "bun run gen:assets && tsc --noEmit",
    "assert:package": "bun run scripts/assert-package.ts ./atrium ./web-dist"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "latest",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5",
    "vite": "^7.3.6"
  }
}
